# DrSnip Reporting MCP — config surface. Copy to .env for local runs, or inject
# via Fly secrets in production. NEVER commit a real .env (it is gitignored).

# The READ-ONLY, PHI-free view role (drsnip_reporting_ro) — NOT the app's
# DATABASE_URL. On Fly's private network use the Flycast host; for a local run
# via `fly proxy 5432 -a drsnip-intake-db`, point at localhost.
#   Fly (deployed):  postgres://drsnip_reporting_ro:PASSWORD@drsnip-intake-db.flycast:5432/drsnip_intake_demo
#   Local (proxied): postgres://drsnip_reporting_ro:PASSWORD@localhost:5432/drsnip_intake_demo
DRSNIP_INTAKE_DATABASE_URL=

# Static bearer for programmatic MCP clients / Claude Desktop (>=16 chars).
MCP_AUTH_TOKEN=

# OAuth 2.1 connector flow (claude.ai). Single shared login password + a signing
# secret for the HMAC-JWT codes/tokens. If unset, only the static bearer works.
OAUTH_LOGIN_PASSWORD=
OAUTH_SIGNING_SECRET=
