# DrSnip intake form — local environment.
# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# Phase 1 (DrSnip): the CJC-era Zapier / Salesforce / TimeTap / Google-OAuth
# variables were removed along with their subsystems. Only the variables below
# are read by the current codebase.

# PostgreSQL connection string. Required by every database-backed route
# (form submit + the admin console). Read by lib/db/src/index.ts.
DATABASE_URL=

# Runtime environment. "production" makes session cookies Secure-only.
# Defaults to development behavior when unset.
NODE_ENV=development

# Port the api-server (api-server/index.ts) listens on. Defaults to 8080.
PORT=8080

# NOTE: admin auth uses opaque server-side session tokens (random id stored
# in the `sessions` table), so no signing secret is needed today. If a signed
# cookie is introduced later, add SESSION_SECRET here.

# ---- n8n bridge (Phase 3) ------------------------------------------------
# Registration + consultation. N8N_BRIDGE_ENABLED is the kill switch for THIS
# path only; it does not affect insurance (below).
N8N_BRIDGE_ENABLED=false
N8N_WEBHOOK_REGISTRATION_URL=
N8N_WEBHOOK_CONSULTATION_URL=
# Shared webhook auth token — must equal DRSNIP_WEBHOOK_SECRET on the n8n side.
# Used by ALL webhook routes (registration, consultation, insurance, notify).
N8N_WEBHOOK_SECRET=

# ---- Insurance → DrChrono chart (Train C) --------------------------------
# SEPARATE kill switch on purpose: insurance can be disabled without touching
# the registration/consultation path that runs the practice, and vice versa.
# When false, insurance submissions behave exactly as before Train C
# (n8n_status = 'not_applicable', no n8n call).
N8N_INSURANCE_BRIDGE_ENABLED=false
N8N_WEBHOOK_INSURANCE_URL=

# Insurance staff doorbell email (existing).
N8N_WEBHOOK_INSURANCE_NOTIFY_URL=

# ---- Insurance documents to the chart (Train D) --------------------------
# Independent of the chart bridge above: documents can be stopped without
# stopping chart creation. When false/unset, the payload tells n8n to skip its
# entire document branch and charts are created exactly as they are today.
# Deliberately an APP variable, not an n8n one — toggling an n8n env var would
# restart the n8n machine and drop in-flight registration/consultation webhooks.
N8N_INSURANCE_DOCS_ENABLED=false

# Service-to-service token for the internal card-file endpoints
# (/api/internal/*) AND the insurance summary PDF endpoint, which the n8n
# Insurance workflow calls when documents are enabled.
# DELIBERATELY a different secret from N8N_WEBHOOK_SECRET so a rotation on the
# card path cannot 401 the bridge webhooks. Unset = endpoints reject everything.
N8N_SERVICE_TOKEN=

# Absolute origin used to build console deep links in notification emails.
PUBLIC_APP_URL=
